{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Frekuensi Pembelian Saham per Provinsi",
    "subtitle": "Hanya Jakarta yang pernah melewati 10 juta transaksi beli dalam sebulan"
  },
  "width": 800,
  "height": 350,
  "params": [
    {
      "name": "bulanKe",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 43,
        "step": 1,
        "name": "Geser bulan (Jan 2023 – Agu 2026): "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/wedantapramarta/wedantapramarta.github.io/refs/heads/main/pembelian_saham_provinsi%20v2.csv",
    "format": {
      "type": "csv",
      "parse": {
        "beli": "number",
        "tahun": "string",
        "bulan": "string"
      }
    }
  },
  "transform": [
    {
      "calculate": "(toNumber(slice(datum.bulan, 0, 4)) - 2023) * 12 + toNumber(slice(datum.bulan, 5, 7)) - 1",
      "as": "idx"
    },
    {
      "filter": "datum.idx == bulanKe"
    },
    {
      "calculate": "['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'][toNumber(slice(datum.bulan, 5, 7)) - 1] + ' ' + slice(datum.bulan, 0, 4)",
      "as": "namaBulan"
    },
    {
      "calculate": "datum.beli < 100000 ? '< 100 rb' : datum.beli < 250000 ? '100 – 250 rb' : datum.beli < 1000000 ? '250 rb – 1 jt' : datum.beli < 2500000 ? '1 – 2,5 jt' : datum.beli < 5000000 ? '2,5 – 5 jt' : datum.beli < 10000000 ? '5 – 10 jt' : '10 – 20 jt'",
      "as": "kelas"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "lookup": "provinsi",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/wedantapramarta/wedantapramarta.github.io/refs/heads/main/indonesia_provinsi.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.Propinsi"
          },
          "as": "geo"
        }
      ],
      "projection": {
        "type": "mercator"
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#bbbbbb",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "kelas",
          "type": "ordinal",
          "scale": {
            "domain": [
              "< 100 rb",
              "100 – 250 rb",
              "250 rb – 1 jt",
              "1 – 2,5 jt",
              "2,5 – 5 jt",
              "5 – 10 jt",
              "10 – 20 jt"
            ],
            "range": [
              "#eff3ff",
              "#c6dbef",
              "#9ecae1",
              "#6baed6",
              "#3182bd",
              "#08519c",
              "#ff6a00"
            ]
          },
          "legend": {
            "title": "Transaksi beli / bulan",
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeColor": "#bbb",
            "symbolStrokeWidth": 0.5,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "provinsi",
            "type": "nominal",
            "title": "Provinsi"
          },
          {
            "field": "namaBulan",
            "type": "nominal",
            "title": "Bulan"
          },
          {
            "field": "beli",
            "type": "quantitative",
            "title": "Frekuensi beli",
            "format": ","
          },
          {
            "field": "kelas",
            "type": "nominal",
            "title": "Kelompok"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [],
          "groupby": [
            "namaBulan"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 22,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "value": 10
        },
        "y": {
          "value": 300
        },
        "text": {
          "field": "namaBulan"
        }
      }
    }
  ],
  "view": {
    "stroke": null
  }
}
