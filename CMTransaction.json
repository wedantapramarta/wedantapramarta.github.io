{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Stock Purchase Frequency by Province in Indonesia",
    "subtitle": "Only Jakarta has ever exceeded 10 million buy transactions in a single month"
  },
  "width": 800,
  "height": 350,
  "params": [
    {
      "name": "bulanKe",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 43,
        "step": 1,
        "name": "Slide month (Jan 2023 – Aug 2026): "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/wedantapramarta/wedantapramarta.github.io/refs/heads/main/pembelian_saham_provinsi%20v2.csv",
    "format": {
      "type": "csv",
      "parse": {
        "beli": "number",
        "tahun": "string",
        "bulan": "string"
      }
    }
  },
  "transform": [
    {
      "calculate": "(toNumber(slice(datum.bulan, 0, 4)) - 2023) * 12 + toNumber(slice(datum.bulan, 5, 7)) - 1",
      "as": "idx"
    },
    {
      "filter": "datum.idx == bulanKe"
    },
    {
      "calculate": "['January','February','March','April','May','June','July','August','September','October','November','December'][toNumber(slice(datum.bulan, 5, 7)) - 1] + ' ' + slice(datum.bulan, 0, 4)",
      "as": "namaBulan"
    },
    {
      "calculate": "datum.beli < 100000 ? '< 100k' : datum.beli < 250000 ? '100k – 250k' : datum.beli < 1000000 ? '250k – 1M' : datum.beli < 2500000 ? '1M – 2.5M' : datum.beli < 5000000 ? '2.5M – 5M' : datum.beli < 10000000 ? '5M – 10M' : '10M – 20M'",
      "as": "kelas"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "lookup": "provinsi",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/wedantapramarta/wedantapramarta.github.io/refs/heads/main/indonesia_provinsi.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.Propinsi"
          },
          "as": "geo"
        }
      ],
      "projection": {
        "type": "mercator"
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#bbbbbb",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "kelas",
          "type": "ordinal",
          "scale": {
            "domain": [
              "< 100k",
              "100k – 250k",
              "250k – 1M",
              "1M – 2.5M",
              "2.5M – 5M",
              "5M – 10M",
              "10M – 20M"
            ],
            "range": [
              "#eff3ff",
              "#c6dbef",
              "#9ecae1",
              "#6baed6",
              "#3182bd",
              "#08519c",
              "#ff6a00"
            ]
          },
          "legend": {
            "title": "Buy transactions / month",
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeColor": "#bbb",
            "symbolStrokeWidth": 0.5,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "provinsi",
            "type": "nominal",
            "title": "Province"
          },
          {
            "field": "namaBulan",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "beli",
            "type": "quantitative",
            "title": "Buy transactions",
            "format": ","
          },
          {
            "field": "kelas",
            "type": "nominal",
            "title": "Range"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [],
          "groupby": [
            "namaBulan"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 22,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "value": 10
        },
        "y": {
          "value": 300
        },
        "text": {
          "field": "namaBulan"
        }
      }
    }
  ],
  "view": {
    "stroke": null
  }
}
