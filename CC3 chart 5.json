{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Stock Purchase Frequency by Province in Indonesia",
    "subtitle": [
      "Only Jakarta has ever exceeded 10 million buy transactions in a single month.",
      "Click a legend color to highlight provinces in that range (double-click the map to reset)."
    ]
  },
  "params": [
    {
      "name": "bulanKe",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 43,
        "step": 1,
        "name": "Slide month (Jan 2023 – Aug 2026): "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/wedantapramarta/wedantapramarta.github.io/refs/heads/main/pembelian_saham_provinsi%20v2.csv",
    "format": {
      "type": "csv",
      "parse": {
        "beli": "number",
        "tahun": "string",
        "bulan": "string",
        "lon": "number",
        "lat": "number"
      }
    }
  },
  "transform": [
    {
      "lookup": "provinsi",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/wedantapramarta/wedantapramarta.github.io/refs/heads/main/kegiatan_provinsi_2024_2025.csv"
        },
        "key": "provinsi_peta",
        "fields": [
          "kode"
        ]
      }
    },
    {
      "calculate": "(toNumber(slice(datum.bulan, 0, 4)) - 2023) * 12 + toNumber(slice(datum.bulan, 5, 7)) - 1",
      "as": "idx"
    },
    {
      "calculate": "['January','February','March','April','May','June','July','August','September','October','November','December'][toNumber(slice(datum.bulan, 5, 7)) - 1] + ' ' + slice(datum.bulan, 0, 4)",
      "as": "namaBulan"
    },
    {
      "calculate": "datum.beli < 100000 ? '< 100k' : datum.beli < 250000 ? '100k – 250k' : datum.beli < 1000000 ? '250k – 1M' : datum.beli < 2500000 ? '1M – 2.5M' : datum.beli < 5000000 ? '2.5M – 5M' : datum.beli < 10000000 ? '5M – 10M' : '10M – 20M'",
      "as": "kelas"
    },
    {
      "calculate": "datum.kode == 'JK' ? datum.lat + 0.9 : datum.kode == 'BT' ? datum.lat + 0.3 : datum.kode == 'YO' ? datum.lat - 0.55 : datum.kode == 'GO' ? datum.lat - 0.35 : datum.lat",
      "as": "latLabel"
    },
    {
      "calculate": "datum.kode == 'BT' ? datum.lon - 0.6 : datum.kode == 'JK' ? datum.lon + 0.2 : datum.lon",
      "as": "lonLabel"
    },
    {
      "filter": "datum.idx == bulanKe"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "width": 620,
  "height": 330,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "transform": [
        {
          "lookup": "provinsi",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/wedantapramarta/wedantapramarta.github.io/refs/heads/main/indonesia_provinsi.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.Propinsi"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#7a7a7a",
        "strokeWidth": 0.35
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "kelas",
          "type": "ordinal",
          "scale": {
            "domain": [
              "< 100k",
              "100k – 250k",
              "250k – 1M",
              "1M – 2.5M",
              "2.5M – 5M",
              "5M – 10M",
              "10M – 20M"
            ],
            "range": [
              "#fff3a0",
              "#a1dab4",
              "#41b6c4",
              "#2c7fb8",
              "#253494",
              "#081d58",
              "#ff6a00"
            ]
          },
          "legend": {
            "title": "Buy transactions / month",
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeColor": "#bbb",
            "symbolStrokeWidth": 0.5,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "provinsi",
            "type": "nominal",
            "title": "Province"
          },
          {
            "field": "kode",
            "type": "nominal",
            "title": "Code"
          },
          {
            "field": "namaBulan",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "beli",
            "type": "quantitative",
            "title": "Buy transactions",
            "format": ","
          },
          {
            "field": "kelas",
            "type": "nominal",
            "title": "Range"
          }
        ],
        "opacity": {
          "condition": {
            "param": "pilihKelas",
            "value": 1
          },
          "value": 0.12
        }
      },
      "params": [
        {
          "name": "pilihKelas",
          "select": {
            "type": "point",
            "fields": [
              "kelas"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontWeight": "bold",
        "stroke": "white",
        "strokeWidth": 2.5,
        "strokeJoin": "round",
        "color": "white"
      },
      "encoding": {
        "longitude": {
          "field": "lonLabel",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latLabel",
          "type": "quantitative"
        },
        "text": {
          "field": "kode",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontWeight": "bold",
        "color": "#1a1a1a"
      },
      "encoding": {
        "longitude": {
          "field": "lonLabel",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latLabel",
          "type": "quantitative"
        },
        "text": {
          "field": "kode",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [],
          "groupby": [
            "namaBulan"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 22,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "value": 10
        },
        "y": {
          "value": 290
        },
        "text": {
          "field": "namaBulan"
        }
      }
    }
  ]
}
