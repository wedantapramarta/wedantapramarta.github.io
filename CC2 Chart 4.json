{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GDP Growth",
    "anchor": "start",
    "subtitle": "Annually, %| Source: FRED through ECO API",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "height": 250,
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": "#ffffff",
  "view": {
    "fill": "#ffffff",
    "strokeOpacity": 0
  },
  "data": {
    "url": "https://api.economicsobservatory.com/usa/grow?vega",
    "format": {
      "type": "json"
    }
  },
  "mark": {
    "type": "bar",
    "color": "#f4134d",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "date",
      "timeUnit": "year",
      "type": "ordinal",
      "axis": {
        "title": "",
        "grid": false,
        "labelAngle": 0,
        "labelOverlap": true,
        "titleColor": "#122B39"
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "title": "",
        "titleColor": "#122B39",
        "grid": false
      }
    }
  }
}
